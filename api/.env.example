PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/task_manager
JWT_SECRET=your_jwt_secret_key_here

# SMTP (Mailtrap sandbox khi phát triển)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Task Manager <no-reply@taskmanager.local>

# Nhắc việc trước hạn
REMINDER_CRON=0 * * * *
REMINDER_HOURS=24
DISABLE_REMINDER_JOB=false
